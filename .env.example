# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Local Postgres (docker compose) ---
# The Postgres image creates POSTGRES_USER as a SUPERUSER owning POSTGRES_DB, and compose
# hands the app that same role as DB_USER. The app never needs it: it issues no DDL of its
# own, and no migration needs more than CREATE on schema public. A deployment therefore
# strips the role once, connected as it:
#   ALTER ROLE <user> NOSUPERUSER NOCREATEROLE NOCREATEDB;
# Locally that survives in the volume but not a `docker compose down -v`, since initdb makes
# POSTGRES_USER a superuser again on a fresh volume.
POSTGRES_DB=nexus
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
# JDBC form, note the jdbc: prefix — a hosted Postgres usually hands out postgresql://…,
# which this will not accept.
DB_URL=jdbc:postgresql://localhost:5432/nexus
DB_USER=
DB_PASSWORD=

# JWT signing key. Generate a fresh one, min 32 bytes:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15

# Whether anyone may still create an account. Set this to false on a deployment once its
# accounts exist: the URL is public, and an open sign-up on it is a stranger spending the
# API budget. Signing in is unaffected either way. Defaults to true when unset.
REGISTRATION_OPEN=true

# A temporary password in front of the whole site, API included, while it is in development.
# Leave blank locally: the gate is off without one. Changing it asks every browser for the new
# one. Only /api/v1/health stays reachable without it.
SITE_PASSWORD=

# How many proxies stand in front of the app. The per-IP limit on login and registration
# reads the caller's address this far in from the end of X-Forwarded-For, so the number has
# to match the deployment: 0 running it directly, 1 behind Railway, 2 with a CDN in front of
# Railway. Setting it higher than the truth lets a caller forge the entry it reads and give
# themselves an unlimited number of buckets. Defaults to 0, and to 1 under the prod profile.
# TRUSTED_PROXY_COUNT=

# The oldest installed app build this deployment still answers, as a semantic version. The
# app reads it on launch and tells its owner to update when its own build is older. Raise it
# only once the replacement release is actually in the store. Unset forces nothing.
# CLIENT_MINIMUM_VERSION=

# --- IGDB (via a Twitch developer application) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- AniList (anilist.co/settings/developer) ---
# Only needed to connect an account and import a list; search works without them.
# The redirect URL registered there must be <FRONTEND_URL>/settings/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# --- MyAnimeList (myanimelist.net/apiconfig) ---
# OAuth like AniList's: needed to connect an account and import a list — including a
# private one, since the list is read as the signed-in user. The "App Redirect URL"
# registered there must be <FRONTEND_URL>/settings/mal/callback
# The secret may stay blank if the app is registered as a public client (PKCE only).
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# --- TMDB (themoviedb.org/settings/api) ---
# The v4 "API Read Access Token", not the v3 key: it is sent as a bearer and never expires.
# Film and TV search is disabled without it; the rest of the app still runs.
TMDB_ACCESS_TOKEN=


# --- Simkl (simkl.com/settings/developer) ---
# The Redirect URI registered there must be <FRONTEND_URL>/settings/simkl/callback.
# Connecting an account is disabled without these; film and TV search still works.
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# --- Open Library (openlibrary.org) ---
# No key and no registration: the only source here with nothing to configure. What it asks
# for instead is a User-Agent naming the app and somewhere to reach whoever runs it, which
# is a condition of use — callers hiding behind a default client User-Agent get throttled.
# The default in application.yml is fine for local development; set this in production.
# OPEN_LIBRARY_USER_AGENT=

# --- Steam (steamcommunity.com/dev/apikey) ---
# One application-wide key, used server-side for every user's library pull.
# The domain field at registration is not enforced; "localhost" is fine.
STEAM_API_KEY=

# --- Column encryption (OAuth tokens at rest) ---
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Changing this makes every already-encrypted token unreadable.
NEXUS_ENCRYPTION_KEY=

# --- App container (docker compose) ---
APP_PORT=8080
# Where Steam returns the browser after sign-in. Leave unset for local development:
# compose defaults it to the container origin, and running the backend directly
# defaults it to the Vite dev server. Set it explicitly only in production.
# FRONTEND_URL=

# --- Frontend (vite dev server only) ---
VITE_API_BASE_URL=http://localhost:8080

# --- Cloudflare Turnstile (dash.cloudflare.com > Turnstile) ---
# The bot check on the sign-up and password-reset forms. Register the deployment's own
# hostname; a widget is bound to the hostnames listed on it. The site key is public and is
# served to the browser by /api/v1/config — the secret key never leaves the server.
# Leave both blank locally: the check switches itself off and the forms still send. A
# deployment reachable from the internet must set them, and warns at boot when it has not.
# Verification fails closed, so a deployment with only one of the two set refuses sign-ups.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Agreement versions ---
# Which version of each document readers are currently held to. Raising one is what puts that
# document back in front of everyone who accepted the older text, so raise it only when the
# change is one a reader should have to accept again.
# Leave all four blank to use the defaults in application.yml, which are the versions this
# build's own pages show. Set one only to force a re-consent without a rebuild.
# Dated, so they sort and match the "Last updated" line on the page itself.
TERMS_VERSION=
PRIVACY_VERSION=
# Native app only (the App Store requires an EULA); never offered to a browser.
EULA_VERSION=
# Web only — a native client sets no cookies, so it is never asked.
COOKIE_POLICY_VERSION=
