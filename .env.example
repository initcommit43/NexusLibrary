# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Local Postgres (docker compose) ---
POSTGRES_DB=nexus
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/nexus
DB_USER=
DB_PASSWORD=

# JWT signing key. Generate a fresh one, min 32 bytes:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15

# --- IGDB (via a Twitch developer application) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
