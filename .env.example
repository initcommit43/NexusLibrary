# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Local Postgres (docker compose) ---
POSTGRES_DB=nexus
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/nexus
DB_USER=
DB_PASSWORD=

# JWT signing key. Generate a fresh one, min 32 bytes:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15

# Whether anyone may still create an account. Set this to false on a deployment once its
# accounts exist: the URL is public, and an open sign-up on it is a stranger spending the
# API budget. Signing in is unaffected either way. Defaults to true when unset.
REGISTRATION_OPEN=true

# How many proxies stand in front of the app. The per-IP limit on login and registration
# reads the caller's address this far in from the end of X-Forwarded-For, so the number has
# to match the deployment: 0 running it directly, 1 behind Railway, 2 with a CDN in front of
# Railway. Setting it higher than the truth lets a caller forge the entry it reads and give
# themselves an unlimited number of buckets. Defaults to 0, and to 1 under the prod profile.
# TRUSTED_PROXY_COUNT=

# --- IGDB (via a Twitch developer application) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- AniList (anilist.co/settings/developer) ---
# Only needed to connect an account and import a list; search works without them.
# The redirect URL registered there must be <FRONTEND_URL>/settings/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# --- MyAnimeList (myanimelist.net/apiconfig) ---
# OAuth like AniList's: needed to connect an account and import a list — including a
# private one, since the list is read as the signed-in user. The "App Redirect URL"
# registered there must be <FRONTEND_URL>/settings/mal/callback
# The secret may stay blank if the app is registered as a public client (PKCE only).
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# --- TMDB (themoviedb.org/settings/api) ---
# The v4 "API Read Access Token", not the v3 key: it is sent as a bearer and never expires.
# Film and TV search is disabled without it; the rest of the app still runs.
TMDB_ACCESS_TOKEN=


# --- Simkl (simkl.com/settings/developer) ---
# The Redirect URI registered there must be <FRONTEND_URL>/settings/simkl/callback.
# Connecting an account is disabled without these; film and TV search still works.
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# --- Open Library (openlibrary.org) ---
# No key and no registration: the only source here with nothing to configure. What it asks
# for instead is a User-Agent naming the app and somewhere to reach whoever runs it, which
# is a condition of use — callers hiding behind a default client User-Agent get throttled.
# The default in application.yml is fine for local development; set this in production.
# OPEN_LIBRARY_USER_AGENT=

# --- Steam (steamcommunity.com/dev/apikey) ---
# One application-wide key, used server-side for every user's library pull.
# The domain field at registration is not enforced; "localhost" is fine.
STEAM_API_KEY=

# --- Column encryption (OAuth tokens at rest) ---
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Changing this makes every already-encrypted token unreadable.
NEXUS_ENCRYPTION_KEY=

# --- App container (docker compose) ---
APP_PORT=8080
# Where Steam returns the browser after sign-in. Leave unset for local development:
# compose defaults it to the container origin, and running the backend directly
# defaults it to the Vite dev server. Set it explicitly only in production.
# FRONTEND_URL=

# --- Frontend (vite dev server only) ---
VITE_API_BASE_URL=http://localhost:8080
