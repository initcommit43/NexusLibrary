# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Local Postgres (docker compose) ---
POSTGRES_DB=nexus
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/nexus
DB_USER=
DB_PASSWORD=

# JWT signing key. Generate a fresh one, min 32 bytes:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15

# --- IGDB (via a Twitch developer application) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- AniList (anilist.co/settings/developer) ---
# Only needed to connect an account and import a list; search works without them.
# The redirect URL registered there must be <FRONTEND_URL>/settings/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# --- Steam (steamcommunity.com/dev/apikey) ---
# One application-wide key, used server-side for every user's library pull.
# The domain field at registration is not enforced; "localhost" is fine.
STEAM_API_KEY=

# --- Column encryption (OAuth tokens at rest) ---
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Changing this makes every already-encrypted token unreadable.
NEXUS_ENCRYPTION_KEY=

# --- App container (docker compose) ---
APP_PORT=8080
# Where Steam returns the browser after sign-in. Leave unset for local development:
# compose defaults it to the container origin, and running the backend directly
# defaults it to the Vite dev server. Set it explicitly only in production.
# FRONTEND_URL=

# --- Frontend (vite dev server only) ---
VITE_API_BASE_URL=http://localhost:8080
